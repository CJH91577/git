# ============ Aegis 配置示例（复制为 .env 使用）============

# ---- LLM（OpenAI 兼容协议，可指向 OpenAI / DeepSeek / Ollama / 通义 / 本地 vLLM 等）----
# provider: openai | ollama | scripted（离线确定性后端，用于 CI/演示）
AEGIS_LLM_PROVIDER=openai
AEGIS_LLM_API_KEY=sk-xxxxxxxx
AEGIS_LLM_BASE_URL=https://api.openai.com/v1
AEGIS_LLM_MODEL=gpt-4o-mini
AEGIS_LLM_TEMPERATURE=0.2

# ---- Embeddings ----
# provider: fastembed（本地免 Key，默认）| openai | ollama
AEGIS_EMBED_PROVIDER=fastembed
AEGIS_EMBED_MODEL=BAAI/bge-small-zh-v1.5
AEGIS_EMBED_API_KEY=
AEGIS_EMBED_BASE_URL=

# ---- 存储 ----
AEGIS_DATA_DIR=./data

# ---- 检索 ----
AEGIS_RETRIEVAL_TOP_K=6
AEGIS_RERANK_TOP_K=4

# ---- 智能体 ----
AEGIS_MAX_AUDIT_ROUNDS=3
AEGIS_AUDITOR_SCORE_THRESHOLD=0.7

# ---- HITL 人工审批 ----
# interactive: 敏感操作挂起等待人工审批（默认）
# auto_approve: 自动放行（仅用于受信任环境/演示）
# auto_deny: 自动拒绝
AEGIS_HITL_ENABLED=true
AEGIS_HITL_MODE=interactive

# ---- MCP ----
# inprocess: 进程内内存通道 | stdio: 独立子进程（标准 MCP stdio 协议）
AEGIS_MCP_TRANSPORT=inprocess
